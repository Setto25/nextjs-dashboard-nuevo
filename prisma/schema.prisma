// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType      = "wasm"
}

datasource db {
  provider = "postgresql"
  
}

// Modelo de DB de pruebas
model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id             Int             @id @default(autoincrement())
  categoria      String          @unique
  nombre         String          @unique
  menuCategorias MenuCategoria[] // Relación inversa necesaria para establecer la relacion fk
}


model MenuCategoria {
  id                  Int         @id @default(autoincrement())
  subCategoria        String      @unique
  nombre              String      @unique
  categoriaId         Int
  relacionCategoria   Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  videos              Video[]     // Relación con videos
  documentos          Documento[] // Relación con documentos
}


// Nuevo modelo de Video  
model Video {
  id              Int           @id @default(autoincrement())
  tema            String
  temaId          Int
  menuCategoria   MenuCategoria @relation(fields: [temaId], references: [id], onDelete: Cascade)
  titulo          String
  tipo            String        @default("URL") // Cambiamos el default a "URL" o algo genérico
  // NUEVOS CAMPOS PARA VIDEOS EXTERNOS en YT Y DAILYMOTION:
  idYoutube       String?       // ID específico de YouTube (Ej: 'dQw4w9WgXcQ')
  idDailymotion   String?       // ID específico de Dailymotion
  plataforma      String?       // Indica la plataforma principal ('YOUTUBE' o 'DAILYMOTION')
  // Se elimina 'url' y 'rutaLocal' ya que no se ajustan al nuevo flujo

  descripcion     String?
  duracion        String?
  categorias      String?
  fechaSubida     DateTime      @default(now())
  miniatura       String?       // Aquí guardaremos la URL de la miniatura
  formato         String?       // Ya no es tan relevante, pero se puede mantener
}

model Documento {
  id              Int           @id @default(autoincrement())
  tema            String
  temaId          Int
  menuCategoria   MenuCategoria @relation(fields: [temaId], references: [id], onDelete: Cascade)
  titulo          String
  tipo            String?       @default("PDF")
  url             String?       
  portada         String?       
  descripcion     String?
  categorias      String?
  fechaSubida     DateTime      @default(now())
  formato         String?       // doc, pdf, ppt, etc.
  contenidoHTML   String?       // Campo para almacenar contenido en HTML desde los docx
}


model plantilla {
  id              Int           @id @default(autoincrement())
  tema            String?
  categoria       String
  titulo          String
  tipo            String?       @default("PDF")
  url             String?       
  portada         String?       
  descripcion     String?
  palabrasClave   String?
  fechaSubida     DateTime      @default(now())
  formato         String?       // doc, pdf, ppt, etc.
}

model CategoriaPlantilla {
 id             Int             @id @default(autoincrement())
  categoria      String          @unique
  nombre         String          @unique
  menuCategorias MenuCategoriaPlantilla[] // Relación inversa necesaria para establecer la relacion fk
}

model MenuCategoriaPlantilla {
  id                  Int                @id @default(autoincrement())
  subCategoria        String             @unique
  nombre              String             @unique
  categoriaId         Int
  relacionCategoria   CategoriaPlantilla @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
}

model User {
  id        Int       @id @default(autoincrement())
  rut       String    @unique // Nuevo campo RUT
  nombre    String
  apellido1 String
  apellido2 String
  email     String    @unique
  password  String
  role      String    @default("user")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Borrado lógico (opcional)
}

model Protocolo {
  id            Int       @id @default(autoincrement())
  codigo        String?
  titulo        String
  descripcion   String
  categoria     String
  version       String
  fechaCreacion DateTime
  fechaRevision DateTime
  vigencia      DateTime?
  creadoPor     String
  storageProvider String @default("Blackblaze_B2") // NUEVO: Proveedor de almacenamiento
  formato       String?   // pdf, epub, mobi, etc.
  url           String?   // ANTES: rutaLocal
  portada     String?   // NUEVO: URL de la portada del protocolo
  fechaSubida   DateTime  @default(now())
}

model ManualEquipo {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  categorias  String?
  fechaSubida DateTime @default(now())
  url         String?
  portada     String?  // URL de la portada del manual
}

model Libro {
  id            Int       @id @default(autoincrement())
  titulo        String
  descripcion   String?
  tema          String?
  version       Int?
  anno          Int?
  categorias    String?
  portada       String?  // URL de la portada del libro
  fechaSubida   DateTime  @default(now())
  storageProvider String @default("Blackblaze_B2") // NUEVO: Proveedor de almacenamiento
  formato       String?   // pdf, epub, mobi, etc.
  url           String?   // ANTES: rutaLocal
  googleFileId  String?   // NUEVO: Para guardar el ID de Google Drive
}

model tema {
  id        Int        @id @default(autoincrement())
  tema      String
  questions PreguntaPrueba[]
}

model preguntas {
  id                Int      @id @default(autoincrement())
  tema              String
  pregunta          String
  alternativas      String
  respuesta         String
  fechaCreacion     DateTime @default(now())
  fechaModificacion DateTime @updatedAt
}

//////////////////////////// GESTION DE INSUMOS ////////////////////////////

model Insumo {
  id               String           @id @default(uuid())
  codigo           String           @unique
  nombre           String
  stockOriginal    Int?             
  activo           Boolean          @default(true) // Borrado logico
  fechaDesactivado DateTime?

  // Relaciones
  movimientosMes   MovimientosMes[]
  movimientos      Movimiento[]
  comentarios      ComentarioInsumo[]
}

model MovimientosMes {
  id               String @id @default(uuid())
  mes              Int
  anio             Int
  stockAjustado    Int    // Stock original, modificable por mes si se requiere
  stockModificable Int    // El stock dinámico que sube o baja en el mes
  
  // Llave foránea (FK)
  idInsumo         String
  insumo           Insumo @relation(fields: [idInsumo], references: [id])
}

model Movimiento {
  id             String   @id @default(uuid())
  fecha          DateTime @default(now())
  balanceRetiros Int?     
  
  // Llave foránea (FK)
  idInsumo       String?  
  insumo         Insumo?  @relation(fields: [idInsumo], references: [id]) 
}

// Bloqueos de meses consolidados
model ControlMes {
  id           String  @id @default(uuid())
  mes          Int
  anio         Int
  desbloqueado Boolean @default(false)

  @@unique([mes, anio])
}

model ComentarioInsumo {
  id        String   @id @default(uuid())
  texto     String
  fecha     DateTime @default(now())
  
  // Relación con el Insumo
  idInsumo  String
  insumo    Insumo   @relation(fields: [idInsumo], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  fecha     DateTime @default(now())
  userId    Int?
  rut       String?
  nombre    String?
  email     String?
  accion    String   // 'INICIO_SESION' o 'ACCESO_PAGINA'
  modulo    String   // 'AUTENTICACION' o 'NAVEGACION'
  detalles  String?  // JSON string
  ip        String?
}

model Prueba {
  id               String   @id @default(cuid())
  title            String
  description      String?
  timeLimitMinutes Int?     
  isActive         Boolean  @default(true)
  preguntas        PreguntaPrueba[] @relation("PruebaQuestions")
  asignaciones     AsignacionPrueba[]
  intentos         IntentoPrueba[]
  createdAt        DateTime @default(now())
  deletedAt        DateTime?
}

model PreguntaPrueba {
  id          String   @id @default(cuid())
  pruebas     Prueba[]   @relation("PruebaQuestions")
  text        String
  opciones    OpcionPrueba[]
  temaId      Int?
  tema        tema?    @relation(fields: [temaId], references: [id], onDelete: SetNull)
}

model OpcionPrueba {
  id          String   @id @default(cuid())
  preguntaId  String
  pregunta    PreguntaPrueba @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean  // NUNCA enviar al cliente
}

model AsignacionPrueba {
  id        String   @id @default(cuid())
  pruebaId  String
  prueba    Prueba     @relation(fields: [pruebaId], references: [id], onDelete: Cascade)
  userId    Int?     
  role      String?  
}

model IntentoPrueba {
  id        String   @id @default(cuid())
  pruebaId  String
  prueba    Prueba     @relation(fields: [pruebaId], references: [id], onDelete: Cascade)
  userId    Int      
  score     Float?   
  status    String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, TIMEOUT
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
  respuestas RespuestaPrueba[]
  snapshot  Json?
}

model RespuestaPrueba {
  id         String   @id @default(cuid())
  intentoId  String
  intento    IntentoPrueba @relation(fields: [intentoId], references: [id], onDelete: Cascade)
  preguntaId String
  opcionId   String
}